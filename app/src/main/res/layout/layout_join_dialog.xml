<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/_200sdp"
    android:layout_height="wrap_content"
    android:background="@drawable/ui_dialog_bg"
    android:orientation="vertical"
    android:padding="@dimen/_14sdp">

    <TextView
        android:id="@+id/join_server_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:textStyle="bold"
        android:maxLines="2"
        android:textColor="@color/launcher_text"
        android:textSize="@dimen/_12ssp" />

    <View
        android:layout_width="@dimen/_28sdp"
        android:layout_height="2dp"
        android:layout_marginTop="@dimen/_7sdp"
        android:background="@color/launcher_accent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_11sdp"
        android:letterSpacing="0.12"
        android:text="@string/player_nickname"
        android:textAllCaps="true"
        android:textColor="@color/launcher_text_dim"
        android:textSize="@dimen/_8ssp" />

    <LinearLayout
        android:id="@+id/join_nickname_row"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_28sdp"
        android:layout_marginTop="@dimen/_4sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/join_nickname"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/launcher_input_bg"
            android:hint="@string/player_nickname"
            android:imeOptions="actionDone|flagNoExtractUi"
            android:inputType="textNoSuggestions"
            android:maxLength="24"
            android:maxLines="1"
            android:paddingStart="@dimen/_10sdp"
            android:paddingEnd="@dimen/_10sdp"
            android:textColor="@color/launcher_text"
            android:textColorHint="@color/launcher_text_dim"
            android:textSize="@dimen/_9ssp" />

        <LinearLayout
            android:id="@+id/join_nickname_history"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/_6sdp"
            android:background="@drawable/launcher_btn_outline"
            android:contentDescription="@string/nickname_history_btn"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_8sdp"
            android:paddingEnd="@dimen/_9sdp">

            <ImageView
                android:layout_width="@dimen/_10sdp"
                android:layout_height="@dimen/_10sdp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_tab_recent"
                android:tint="@color/launcher_accent" />

            <TextView
                android:id="@+id/join_nickname_history_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_4sdp"
                android:text="@string/nickname_history_btn"
                android:textColor="@color/launcher_text"
                android:textSize="@dimen/_8ssp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:letterSpacing="0.12"
        android:text="@string/sa_mp_version"
        android:textAllCaps="true"
        android:textColor="@color/launcher_text_dim"
        android:textSize="@dimen/_8ssp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_28sdp"
        android:layout_marginTop="@dimen/_4sdp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/join_version_0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/launcher_btn_primary"
            android:textStyle="bold"
            android:gravity="center"
            android:text="0.3.7"
            android:textColor="@color/launcher_on_accent"
            android:textSize="@dimen/_9ssp" />

        <TextView
            android:id="@+id/join_version_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/_6sdp"
            android:layout_weight="1"
            android:background="@drawable/launcher_btn_outline"
            android:textStyle="bold"
            android:gravity="center"
            android:text="0.3.7-R5"
            android:textColor="@color/launcher_text_dim"
            android:textSize="@dimen/_9ssp" />

        <TextView
            android:id="@+id/join_version_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/_6sdp"
            android:layout_weight="1"
            android:background="@drawable/launcher_btn_outline"
            android:textStyle="bold"
            android:gravity="center"
            android:text="0.3.DL-R1"
            android:textColor="@color/launcher_text_dim"
            android:textSize="@dimen/_9ssp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/join_password_group"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_28sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <EditText
            android:id="@+id/join_password"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/launcher_input_bg"
            android:hint="@string/server_password_hint"
            android:imeOptions="actionDone|flagNoExtractUi"
            android:inputType="textPassword"
            android:maxLines="1"
            android:paddingStart="@dimen/_10sdp"
            android:paddingEnd="@dimen/_10sdp"
            android:textColor="@color/launcher_text"
            android:textColorHint="@color/launcher_text_dim"
            android:textSize="@dimen/_9ssp" />

        <TextView
            android:id="@+id/join_password_toggle"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/_6sdp"
            android:background="@drawable/launcher_btn_outline"
            android:gravity="center"
            android:paddingStart="@dimen/_10sdp"
            android:paddingEnd="@dimen/_10sdp"
            android:text="@string/password_show"
            android:textColor="@color/launcher_text_dim"
            android:textSize="@dimen/_8ssp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_30sdp"
        android:layout_marginTop="@dimen/_13sdp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/join_cancel"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/launcher_btn_outline"
            android:gravity="center"
            android:paddingStart="@dimen/_14sdp"
            android:paddingEnd="@dimen/_14sdp"
            android:text="@string/cancel"
            android:textColor="@color/launcher_text_dim"
            android:textSize="@dimen/_9ssp" />

        <TextView
            android:id="@+id/join_connect"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_weight="1"
            android:background="@drawable/launcher_btn_primary"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:text="@string/join_server"
            android:textAllCaps="true"
            android:textColor="@color/launcher_on_accent"
            android:textSize="@dimen/_10ssp" />

    </LinearLayout>

</LinearLayout>
